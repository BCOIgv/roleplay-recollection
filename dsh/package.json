{
  "name": "roleplay-recollection-dsh",
  "version": "0.3.0",
  "description": "DSH bundle for roleplay-recollection: source-backed character recollection and recall tools.",
  "license": "MIT",
  "author": "AI Roleplay Recollection contributors",
  "type": "module",
